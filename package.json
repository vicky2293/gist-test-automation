{
  "name": "gist",
  "version": "1.0.0",
  "description": "Test automation for Gist",
  "license": "ISC",
  "author": "vignesh",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "api:test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npx playwright test",
    "test-ui": "npx playwright test --ui",
    "test-chrome": "  npx playwright test --project=chromium",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1"
  }
}
